{
  "format": "weetodd-workflow-v1",
  "id": "weetodd.music-video-planning",
  "version": "1.2.0",
  "name": "Create a music video",
  "description": "Plan a music video around the unchanged song using optional native learned beats, vocal isolation and English word evidence. Review uncertain lyrics, structure and cuts; retain reusable production objects.",
  "inputs": {
    "brief": {
      "type": "text",
      "label": "Movie idea",
      "default": ""
    },
    "duration_seconds": {
      "type": "number",
      "label": "Movie length in seconds",
      "default": 30,
      "minimum": 1,
      "maximum": 3600
    },
    "target_clip_seconds": {
      "type": "number",
      "label": "Preferred clip length",
      "default": 5,
      "minimum": 1,
      "maximum": 60
    },
    "frame_rate": {
      "type": "integer",
      "label": "Movie FPS",
      "default": 24,
      "minimum": 1,
      "maximum": 120
    },
    "images": {
      "type": "image_list",
      "label": "Character and style references",
      "default": []
    },
    "visual_style": {
      "type": "text",
      "label": "Visual style",
      "default": "Let the director decide"
    },
    "presentation": {
      "type": "text",
      "label": "Presentation",
      "default": "Widescreen"
    },
    "camera_style": {
      "type": "text",
      "label": "Camera style",
      "default": "Let the director decide"
    },
    "audio_style": {
      "type": "text",
      "label": "Sound",
      "default": "Preserve the original source song"
    },
    "design_policy": {
      "type": "text",
      "label": "Missing visual details",
      "default": "Propose missing details for approval"
    },
    "constraints": {
      "type": "text",
      "label": "Must keep or avoid",
      "default": ""
    },
    "library": {
      "type": "object_catalog",
      "label": "Available reusable objects",
      "default": []
    },
    "audio_path": {
      "type": "text",
      "label": "Audio path",
      "default": ""
    },
    "audio_sha256": {
      "type": "text",
      "label": "Audio sha256",
      "default": ""
    },
    "source_start_seconds": {
      "type": "number",
      "label": "Source start seconds",
      "default": 0
    },
    "lyrics": {
      "type": "text",
      "label": "Lyrics",
      "default": ""
    },
    "lyrics_status": {
      "type": "text",
      "label": "Lyrics status",
      "default": "unknown"
    },
    "generation_engine": {
      "type": "text",
      "label": "Generation engine",
      "default": "ltx25"
    },
    "generation_task": {
      "type": "text",
      "label": "Generation task",
      "default": "a2v"
    },
    "min_clip_seconds": {
      "type": "number",
      "label": "Min clip seconds",
      "default": 0
    },
    "max_clip_seconds": {
      "type": "number",
      "label": "Max clip seconds",
      "default": 15
    },
    "backend_min_seconds": {
      "type": "number",
      "label": "Backend min seconds",
      "default": 0
    },
    "backend_max_seconds": {
      "type": "number",
      "label": "Backend max seconds",
      "default": 0
    },
    "timing_markers": {
      "type": "text",
      "label": "Timing markers",
      "default": "[]"
    },
    "pacing": {
      "type": "text",
      "label": "Pacing",
      "default": "Let the director decide"
    },
    "continuity_enabled": {
      "type": "boolean",
      "label": "Continuity enabled",
      "default": true
    },
    "analysis_mode": {
      "type": "text",
      "label": "Audio analysis",
      "default": "fast"
    },
    "analysis_model_directory": {
      "type": "text",
      "label": "Analysis model folder",
      "default": ""
    },
    "analysis_vocal_mode": {
      "type": "text",
      "label": "Vocal timing input",
      "default": "mixed"
    }
  },
  "models": {
    "assistant": {
      "family": "qwen3.5",
      "variant": "4b",
      "runtime": "drawthings-qwen-local",
      "capabilities": [
        "text",
        "vision"
      ]
    }
  },
  "steps": [
    {
      "id": "analysis",
      "name": "Analysis",
      "operation": "music.analyze@3",
      "inputs": {
        "audio_path": {
          "input": "audio_path"
        },
        "audio_sha256": {
          "input": "audio_sha256"
        },
        "lyrics": {
          "input": "lyrics"
        },
        "lyrics_status": {
          "input": "lyrics_status"
        },
        "analysis_mode": {
          "input": "analysis_mode"
        },
        "analysis_model_directory": {
          "input": "analysis_model_directory"
        },
        "analysis_vocal_mode": {
          "input": "analysis_vocal_mode"
        }
      },
      "parameters": {},
      "retry": {
        "maxAttempts": 1
      },
      "timeoutSeconds": 3600,
      "requiresApproval": false
    },
    {
      "id": "describe",
      "name": "Reference observations",
      "operation": "vision.describe@1",
      "inputs": {
        "images": {
          "input": "images"
        }
      },
      "parameters": {},
      "retry": {
        "maxAttempts": 1
      },
      "timeoutSeconds": 120,
      "model": "assistant"
    },
    {
      "id": "creative_brief",
      "name": "Your creative brief",
      "operation": "music.prepare_brief@1",
      "inputs": {
        "brief": {
          "input": "brief"
        },
        "duration_seconds": {
          "input": "duration_seconds"
        },
        "target_clip_seconds": {
          "input": "target_clip_seconds"
        },
        "frame_rate": {
          "input": "frame_rate"
        },
        "visual_style": {
          "input": "visual_style"
        },
        "presentation": {
          "input": "presentation"
        },
        "camera_style": {
          "input": "camera_style"
        },
        "audio_style": {
          "input": "audio_style"
        },
        "design_policy": {
          "input": "design_policy"
        },
        "constraints": {
          "input": "constraints"
        },
        "observations": {
          "step": "describe",
          "output": "observations"
        },
        "lyrics": {
          "input": "lyrics"
        },
        "lyrics_status": {
          "input": "lyrics_status"
        }
      },
      "parameters": {},
      "retry": {
        "maxAttempts": 2
      },
      "timeoutSeconds": 3600,
      "model": "assistant",
      "requiresApproval": true
    },
    {
      "id": "resolve",
      "name": "Apply your choices",
      "operation": "movie.resolve_creative_brief@1",
      "inputs": {
        "creative_brief": {
          "step": "creative_brief",
          "output": "creative_brief"
        }
      },
      "parameters": {},
      "retry": {
        "maxAttempts": 1
      },
      "timeoutSeconds": 3600,
      "requiresApproval": false
    },
    {
      "id": "subjects",
      "name": "Identify visual subjects",
      "operation": "project.identify_creative_subjects@1",
      "inputs": {
        "brief": {
          "step": "resolve",
          "output": "source_brief"
        }
      },
      "parameters": {},
      "retry": {
        "maxAttempts": 2
      },
      "timeoutSeconds": 3600,
      "model": "assistant",
      "requiresApproval": false
    },
    {
      "id": "classify",
      "name": "Classify subjects",
      "operation": "project.classify_subjects@1",
      "inputs": {
        "subjects": {
          "step": "subjects",
          "output": "subjects"
        },
        "brief": {
          "step": "resolve",
          "output": "source_brief"
        }
      },
      "parameters": {},
      "retry": {
        "maxAttempts": 2
      },
      "timeoutSeconds": 3600,
      "model": "assistant",
      "requiresApproval": false
    },
    {
      "id": "links",
      "name": "Link reusable objects",
      "operation": "project.link_subjects@1",
      "inputs": {
        "subjects": {
          "step": "classify",
          "output": "subjects"
        },
        "brief": {
          "step": "resolve",
          "output": "source_brief"
        }
      },
      "parameters": {},
      "retry": {
        "maxAttempts": 1
      },
      "timeoutSeconds": 3600,
      "model": "assistant",
      "requiresApproval": false
    },
    {
      "id": "inventory",
      "name": "Review inventory and library matches",
      "operation": "project.review_object_coverage@1",
      "inputs": {
        "subjects": {
          "step": "links",
          "output": "subjects"
        },
        "brief": {
          "step": "resolve",
          "output": "source_brief"
        },
        "library": {
          "input": "library"
        }
      },
      "parameters": {},
      "retry": {
        "maxAttempts": 1
      },
      "timeoutSeconds": 3600,
      "model": "assistant",
      "requiresApproval": false
    },
    {
      "id": "design",
      "name": "Review visual designs",
      "operation": "project.review_creative_subjects@1",
      "inputs": {
        "subjects": {
          "step": "inventory",
          "output": "subjects"
        },
        "brief": {
          "step": "resolve",
          "output": "source_brief"
        },
        "creative_brief": {
          "step": "creative_brief",
          "output": "creative_brief"
        }
      },
      "parameters": {},
      "retry": {
        "maxAttempts": 1
      },
      "timeoutSeconds": 3600,
      "model": "assistant",
      "requiresApproval": false
    },
    {
      "id": "subjects_coverage",
      "name": "Review final object coverage",
      "operation": "project.review_object_coverage@1",
      "inputs": {
        "subjects": {
          "step": "design",
          "output": "subjects"
        },
        "brief": {
          "step": "resolve",
          "output": "source_brief"
        },
        "library": {
          "input": "library"
        }
      },
      "parameters": {},
      "retry": {
        "maxAttempts": 1
      },
      "timeoutSeconds": 3600,
      "model": "assistant",
      "requiresApproval": true
    },
    {
      "id": "timing",
      "name": "Timing",
      "operation": "music.plan_timing@1",
      "inputs": {
        "analysis": {
          "step": "analysis",
          "output": "analysis"
        },
        "creative_brief": {
          "step": "creative_brief",
          "output": "creative_brief"
        },
        "audio_path": {
          "input": "audio_path"
        },
        "audio_sha256": {
          "input": "audio_sha256"
        },
        "source_start_seconds": {
          "input": "source_start_seconds"
        },
        "lyrics": {
          "input": "lyrics"
        },
        "lyrics_status": {
          "input": "lyrics_status"
        },
        "generation_engine": {
          "input": "generation_engine"
        },
        "generation_task": {
          "input": "generation_task"
        },
        "min_clip_seconds": {
          "input": "min_clip_seconds"
        },
        "max_clip_seconds": {
          "input": "max_clip_seconds"
        },
        "backend_min_seconds": {
          "input": "backend_min_seconds"
        },
        "backend_max_seconds": {
          "input": "backend_max_seconds"
        },
        "timing_markers": {
          "input": "timing_markers"
        },
        "pacing": {
          "input": "pacing"
        },
        "continuity_enabled": {
          "input": "continuity_enabled"
        }
      },
      "parameters": {},
      "retry": {
        "maxAttempts": 1
      },
      "timeoutSeconds": 3600,
      "requiresApproval": false,
      "model": "assistant"
    },
    {
      "id": "story",
      "name": "Treatment",
      "operation": "music.plan_treatment@1",
      "inputs": {
        "subjects": {
          "step": "subjects_coverage",
          "output": "subjects"
        },
        "creative_brief": {
          "step": "creative_brief",
          "output": "creative_brief"
        },
        "brief": {
          "step": "resolve",
          "output": "brief"
        },
        "observations": {
          "step": "describe",
          "output": "observations"
        },
        "duration_seconds": {
          "step": "resolve",
          "output": "duration_seconds"
        },
        "target_clip_seconds": {
          "step": "resolve",
          "output": "target_clip_seconds"
        },
        "frame_rate": {
          "step": "resolve",
          "output": "frame_rate"
        },
        "music_timing": {
          "step": "timing",
          "output": "music_timing"
        }
      },
      "parameters": {},
      "retry": {
        "maxAttempts": 1
      },
      "timeoutSeconds": 3600,
      "model": "assistant",
      "requiresApproval": false
    },
    {
      "id": "clips",
      "name": "Clips",
      "operation": "music.plan_beats@1",
      "inputs": {
        "story": {
          "step": "story",
          "output": "story"
        },
        "duration_seconds": {
          "step": "resolve",
          "output": "duration_seconds"
        },
        "target_clip_seconds": {
          "step": "resolve",
          "output": "target_clip_seconds"
        },
        "frame_rate": {
          "step": "resolve",
          "output": "frame_rate"
        },
        "subjects": {
          "step": "subjects_coverage",
          "output": "subjects"
        },
        "creative_brief": {
          "step": "creative_brief",
          "output": "creative_brief"
        },
        "music_timing": {
          "step": "timing",
          "output": "music_timing"
        }
      },
      "parameters": {
        "maxClips": 200
      },
      "retry": {
        "maxAttempts": 1
      },
      "timeoutSeconds": 3600,
      "requiresApproval": true,
      "model": "assistant"
    },
    {
      "id": "endpoints",
      "name": "Endpoints",
      "operation": "movie.plan_endpoints@2",
      "inputs": {
        "clips": {
          "step": "clips",
          "output": "clips"
        }
      },
      "parameters": {},
      "retry": {
        "maxAttempts": 1
      },
      "timeoutSeconds": 120
    },
    {
      "id": "check",
      "name": "Check",
      "operation": "music.check_plan@1",
      "inputs": {
        "clips": {
          "step": "clips",
          "output": "clips"
        },
        "endpoints": {
          "step": "endpoints",
          "output": "endpoints"
        },
        "duration_seconds": {
          "step": "resolve",
          "output": "duration_seconds"
        },
        "frame_rate": {
          "step": "resolve",
          "output": "frame_rate"
        },
        "music_timing": {
          "step": "timing",
          "output": "music_timing"
        }
      },
      "parameters": {},
      "retry": {
        "maxAttempts": 1
      },
      "timeoutSeconds": 120
    },
    {
      "id": "prompt_preview",
      "name": "Video prompt drafts",
      "operation": "music.compile_prompts@1",
      "inputs": {
        "subjects": {
          "step": "subjects_coverage",
          "output": "subjects"
        },
        "creative_brief": {
          "step": "creative_brief",
          "output": "creative_brief"
        },
        "clips": {
          "step": "clips",
          "output": "clips"
        },
        "planning_review": {
          "step": "check",
          "output": "review"
        }
      },
      "parameters": {},
      "retry": {
        "maxAttempts": 1
      },
      "timeoutSeconds": 3600,
      "requiresApproval": false
    }
  ],
  "outputs": {
    "creative_brief": {
      "step": "creative_brief",
      "output": "creative_brief"
    },
    "subjects": {
      "step": "subjects_coverage",
      "output": "subjects"
    },
    "story": {
      "step": "story",
      "output": "story"
    },
    "clips": {
      "step": "clips",
      "output": "clips"
    },
    "endpoints": {
      "step": "endpoints",
      "output": "endpoints"
    },
    "review": {
      "step": "check",
      "output": "review"
    },
    "prompt_plan": {
      "step": "prompt_preview",
      "output": "prompt_plan"
    },
    "music_timing": {
      "step": "timing",
      "output": "music_timing"
    }
  },
  "limits": {
    "maxParallelSteps": 1,
    "maxStepExecutions": 2048,
    "maxArtifacts": 64,
    "maxWorkingBytes": 536870912
  }
}
